#!/usr/bin/expect -f

set timeout 20
set ip "193.203.160.3"
set user "s3t_dev"
set password "Travels2026#"

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        send "pm2 delete 2 || true\r"
        expect "$ "
        send "pm2 start s3t-frontend\r"
        expect "$ "
        send "pm2 save\r"
        expect "$ "
        send "sleep 5\r"
        send "pm2 list\r"
        expect "$ "
        send "curl -I https://srisaisenthiltravels.cloud/api/Agreements\r"
        expect "$ "
        send "exit\r"
    }
}

expect eof
