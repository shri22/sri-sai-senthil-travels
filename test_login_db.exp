#!/usr/bin/expect -f

set timeout 20
set ip "193.203.160.3"
set user "s3t_dev"
set password "Travels2026#"

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        send "curl -X POST https://srisaisenthiltravels.cloud/api/Auth/login -H \"Content-Type: application/json\" -d '{\"username\":\"admin\",\"password\":\"admin\"}'\r"
        expect "$ "
        send "pm2 logs s3t-api --lines 50 --no-daemon\r"
        sleep 5
        send "\x03"
        expect "$ "
        send "exit\r"
    }
}

expect eof
