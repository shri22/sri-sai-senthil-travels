#!/usr/bin/expect -f

set timeout 20
set ip "193.203.160.3"
set user "s3t_dev"
set password "Travels2026#"

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        send "pm2 stop all\r"
        expect "$ "
        send "pkill -9 dotnet\r"
        expect "$ "
        send "pkill -9 node\r"
        expect "$ "
        send "lsof -i :5000\r"
        expect "$ "
        send "pm2 start s3t-api\r"
        expect "$ "
        send "sleep 5\r"
        send "pm2 list\r"
        expect "$ "
        send "exit\r"
    }
}

expect eof
